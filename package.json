{
  "name": "ipaas",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint src scripts prisma",
    "test": "vitest",
    "db:up": "docker compose up -d --wait db redis",
    "db:down": "docker compose down",
    "setup": "npm run db:up && npx prisma migrate deploy && npx prisma db seed",
    "dev:docker": "npm run setup && npm run dev",
    "setup:env": "npx tsx scripts/setup-env.ts",
    "generate-provider": "npx tsx scripts/generate-provider.ts",
    "encrypt-credentials": "npx tsx scripts/encrypt-credentials.ts",
    "seed:crm": "npx tsx scripts/seed-crm-sandbox.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@scalar/api-reference-react": "^0.9.32",
    "@types/three": "^0.184.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "lightningcss": "^1.32.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.17"
  }
}
