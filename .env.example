# =============================================================================
# Open IpaaS configuration
#
# Fastest path, nothing to fill in by hand:
#
#     npm run setup:env       writes .env with every secret generated
#     docker compose up --build
#
# Or copy this file to .env and work through it. Values below are the working
# development defaults; the comments say which ones must change in production.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (required)
#
# The docker-compose Postgres. Point this at a managed database for a real
# deployment. Neon, Supabase and Railway all hand you a URL in this shape.
# Managed providers usually require ?sslmode=require on the end.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ipaas_dev"


# -----------------------------------------------------------------------------
# Public URL (required)
#
# Where this application answers. It builds the OAuth redirect URI, so it has to
# match the callback you registered with each provider, exactly, including the
# scheme. Registering http://localhost:3000/... while this says https:// is the
# usual reason an otherwise correct OAuth flow fails.
#
# Callback URL to register:  <this value>/api/oauth/callback/<provider-slug>
#                    e.g.    http://localhost:3000/api/oauth/callback/conta-azul
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Credential encryption (CHANGE THIS IN PRODUCTION)
#
# AES-256-GCM key for every provider token stored in the database. 32 bytes,
# base64 or hex.
#
# The default below is published in this repository, so it protects nothing.
# The app refuses to start in production while it is still in place.
#
#   npm run setup:env -- --print      generates a replacement
#
# Treat it like a database backup: lose it and every connected account has to
# reconnect, because the stored tokens can no longer be decrypted. Rotating it
# is a migration, see scripts/encrypt-credentials.ts.
# -----------------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEY="ZGV2ZWxvcG1lbnQtb25seS1lbmNyeXB0aW9uLWtleSE="


# -----------------------------------------------------------------------------
# Admin dashboard (CHANGE THESE IN PRODUCTION)
#
# One shared operator password, plus the key that signs session cookies.
# Changing the session secret logs everyone out, which is how you revoke a
# session that should not exist.
#
# Without both, /dashboard is unreachable rather than unprotected.
# -----------------------------------------------------------------------------
DASHBOARD_PASSWORD="development-only"
DASHBOARD_SESSION_SECRET="ZGV2ZWxvcG1lbnQtb25seS1zZXNzaW9uLXNlY3JldCE="


# -----------------------------------------------------------------------------
# Internal jobs (CHANGE THIS IN PRODUCTION)
#
# Authorizes the webhook delivery job. Anything that knows this value can
# trigger delivery runs.
# -----------------------------------------------------------------------------
INTERNAL_JOB_SECRET="development-only-job-secret"


# -----------------------------------------------------------------------------
# Shared state (optional for one instance, REQUIRED for more than one)
#
# Rate limiting and idempotency fall back to process memory when this is empty.
# That is fine for one container and wrong for two: N instances each enforce
# their own limit, so the real ceiling becomes N times what you configured, and
# a retried request can land on an instance that never saw the first attempt.
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"


# -----------------------------------------------------------------------------
# Public API rate limit, per client, per minute
# -----------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE="600"


# =============================================================================
# Provider OAuth apps
#
# Left blank on purpose: these come from each provider's developer portal and
# nobody can generate them for you. A provider without its pair stays visible in
# the catalog and refuses to connect, which is the intended behaviour.
#
# Naming convention: <PROVIDER_SLUG>_CLIENT_ID and <PROVIDER_SLUG>_CLIENT_SECRET.
# Adding an OAuth provider needs no code change here, only the matching pair.
# =============================================================================

# https://developers.contaazul.com
# Callback: <NEXT_PUBLIC_APP_URL>/api/oauth/callback/conta-azul
CONTA_AZUL_CLIENT_ID=""
CONTA_AZUL_CLIENT_SECRET=""

# https://developers.rdstation.com/reference/criar-aplicativo-appstore
# Create a private app at https://appstore.rdstation.com/pt-BR/publisher
# (logging in needs an RD Station Marketing account) for the RD Station CRM
# product. Callback: <NEXT_PUBLIC_APP_URL>/api/oauth/callback/rd-station-crm
RD_STATION_CRM_CLIENT_ID=""
RD_STATION_CRM_CLIENT_SECRET=""

# https://www.tiny.com.br/api-docs
# Callback: <NEXT_PUBLIC_APP_URL>/api/oauth/callback/tiny
TINY_CLIENT_ID=""
TINY_CLIENT_SECRET=""
