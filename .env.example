# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ipaas_dev"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Credential encryption (REQUIRED IN PRODUCTION)
#
# 32 bytes, base64 or hex. Encrypts every stored ERP token at rest.
# Generate with:  openssl rand -base64 32
#
# Without it the app boots in development and stores credentials as plaintext,
# but refuses to start storing them in production.
# ---------------------------------------------------------------------------
CREDENTIALS_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Admin dashboard
#
# Both are required for /dashboard to be reachable.
# Generate the secret with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=""
DASHBOARD_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Internal jobs (webhook delivery queue)
# ---------------------------------------------------------------------------
INTERNAL_JOB_SECRET=""

# ---------------------------------------------------------------------------
# Shared state (optional for a single instance, REQUIRED for more than one)
#
# Without it, rate limiting and idempotency are per-process: N instances each
# enforce their own limit, so the effective ceiling is N times what you set.
# ---------------------------------------------------------------------------
REDIS_URL=""

# ---------------------------------------------------------------------------
# Public API rate limit, per client, per minute
# ---------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE="600"

# ---------------------------------------------------------------------------
# Provider OAuth apps
#
# Naming convention: <PROVIDER_SLUG>_CLIENT_ID / <PROVIDER_SLUG>_CLIENT_SECRET.
# A new OAuth provider needs no code change here — just the matching pair.
# ---------------------------------------------------------------------------
CONTA_AZUL_CLIENT_ID=""
CONTA_AZUL_CLIENT_SECRET=""

TINY_CLIENT_ID=""
TINY_CLIENT_SECRET=""
