// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person who signs in to the admin console.
///
/// Separate from Client, which is an API consumer and never signs in here.
model DashboardUser {
  id String @id @default(uuid())
  /// Stored lowercased and trimmed, so sign-in is case-insensitive.
  email String @unique
  name  String?
  /// scrypt, salt included. The plaintext never leaves the login form.
  passwordHash String
  /// OWNER or MEMBER. A string rather than an enum so adding a role later is a
  /// code change and not a migration on a table every session reads.
  role         String    @default("MEMBER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  passwordResets PasswordResetToken[]
}

/// One password reset link, in the state it was left in.
///
/// The link is the credential, so only its hash is here: a database dump, a log
/// line or a backup cannot be turned back into a working link. Rows are kept
/// after use because two of them side by side are how you see a link being
/// replayed.
model PasswordResetToken {
  id     String        @id @default(uuid())
  userId String
  user   DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the token in the URL, hex. Unique, so a collision is a conflict
  /// rather than two accounts sharing a link.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys          ApiKey[]
  linkedAccounts   LinkedAccount[]
  requestLogs      RequestLog[]
  idempotencyKeys  IdempotencyKey[]
  webhookEndpoints WebhookEndpoint[]
}

model ApiKey {
  id        String    @id @default(uuid())
  // SHA-256 of the key. The plaintext is shown once, at creation, and never stored.
  keyHash   String?   @unique
  // Leading characters kept in the clear so the dashboard can identify a key.
  keyPrefix String?
  name      String?
  /// What this key may do, as `action:resource` (`read:contacts`, `write:*`).
  /// Empty means everything, which is how keys issued before scopes behave.
  scopes    String[]  @default([])
  // Legacy plaintext column, kept until every row is migrated to keyHash.
  key       String?   @unique
  clientId  String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// A credential that crosses clients: it creates them and issues their keys.
///
/// Separate from ApiKey rather than a flag on it, because the two answer
/// different questions. An ApiKey says which client a request is for; this one
/// says a request is not for any client in particular, and may make new ones.
model AdminKey {
  id         String    @id @default(uuid())
  /// SHA-256 of the key. The plaintext is shown once and never stored.
  keyHash    String    @unique
  /// Leading characters, kept clear so the dashboard can name a key.
  keyPrefix  String
  name       String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

model LinkedAccount {
  id           String   @id @default(uuid())
  clientId     String
  provider     String // registry slug, e.g. 'CONTA_AZUL', 'OMIE'
  accountToken String   @unique @default(uuid()) // The X-Account-Token
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  credentials OAuthCredential[]

  @@index([clientId, provider])
}

model OAuthCredential {
  id              String  @id @default(uuid())
  linkedAccountId String
  // All four hold AES-256-GCM ciphertext once CREDENTIALS_ENCRYPTION_KEY is set.
  accessToken     String
  refreshToken    String?
  erpClientId     String?
  erpClientSecret String?

  // Which auth scheme this credential represents, mirroring the manifest.
  authType String @default("OAUTH2")
  // Encrypted JSON bag for provider-specific fields (appKey, appSecret, ...).
  secrets  String?
  // Per-tenant host (Salesforce instance_url, Shopify shop domain).
  instanceUrl String?
  // Per-tenant path segment (Nuvemshop store id).
  externalTenantId String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  linkedAccount LinkedAccount @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)

  @@index([linkedAccountId])
}

/// One row per unified API call. Powers the logs dashboard, debugging and usage metering.
model RequestLog {
  id              String   @id @default(uuid())
  requestId       String
  clientId        String?
  linkedAccountId String?
  provider        String?
  method          String
  path            String
  status          Int
  latencyMs       Int
  errorCode       String?
  createdAt       DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([createdAt])
}

/// Replays the stored response when a client retries a write with the same key.
model IdempotencyKey {
  id           String   @id @default(uuid())
  clientId     String
  key          String
  endpoint     String
  // Hash of the request body, so the same key with a different payload is rejected.
  requestHash  String
  status       Int
  responseBody Json?
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, key])
  @@index([createdAt])
}

/// Short-lived, single-use OAuth state. Blocks CSRF on the connect callback.
model OAuthState {
  id           String    @id @default(uuid())
  state        String    @unique
  clientId     String
  provider     String
  redirectUri  String
  // PKCE verifier for providers that support it.
  codeVerifier String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([expiresAt])
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  clientId  String
  url       String
  /// Encrypted; used to sign outbound deliveries.
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([clientId])
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  endpointId     String
  eventType      String
  payload        Json
  /// PENDING | DELIVERED | FAILED
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  responseStatus Int?
  lastError      String?
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  createdAt      DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}
